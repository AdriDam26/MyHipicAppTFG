<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F2EE">

    <!-- TOOLBAR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEquino"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5D3A1A"
        app:title="Registro de Equino"
        app:titleTextColor="#FFFFFF"
        app:subtitleTextColor="#E8D5A3"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#FFFFFF"/>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ─────────────────────────────────────── -->
            <!-- SEPARADOR — Datos del Equino            -->
            <!-- ─────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="#8B1A2E"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Datos del Equino"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="#1E3D1E"
                    android:textAllCaps="true"/>

                <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="1dp"
                    android:background="#C8860A"
                    android:alpha="0.4"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <!-- NOMBRE -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layNombreEquino"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Nombre del Caballo"
                app:boxStrokeColor="#1E3D1E"
                app:hintTextColor="#1E3D1E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreEquino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- RAZA -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layRaza"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Raza"
                app:boxStrokeColor="#1E3D1E"
                app:hintTextColor="#1E3D1E">

                <AutoCompleteTextView
                    android:id="@+id/etRaza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- MICROCHIP -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layMicrochip"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Número de Microchip"
                app:boxStrokeColor="#1E3D1E"
                app:hintTextColor="#1E3D1E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMicrochip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="15"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- FECHA DE NACIMIENTO -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layFechaNacimiento"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Fecha de Nacimiento"
                app:startIconTint="#7D5A2E"
                app:boxStrokeColor="#1E3D1E"
                app:hintTextColor="#1E3D1E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaNacimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SEXO + TEMPERAMENTO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:hint="Sexo"
                    app:boxStrokeColor="#1E3D1E"
                    app:hintTextColor="#1E3D1E">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerSexoEquino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:hint="Temperamento"
                    app:boxStrokeColor="#1E3D1E"
                    app:hintTextColor="#1E3D1E">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerTemperamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ALTURA + PESO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:hint="Altura (m)"
                    app:boxStrokeColor="#1E3D1E"
                    app:hintTextColor="#1E3D1E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAltura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:hint="Peso (kg)"
                    app:boxStrokeColor="#1E3D1E"
                    app:hintTextColor="#1E3D1E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPeso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ESTADO DE SALUD -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Estado de Salud"
                app:boxStrokeColor="#1E3D1E"
                app:hintTextColor="#1E3D1E">

                <AutoCompleteTextView
                    android:id="@+id/spinnerSalud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- NÚMERO DE CUADRA -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layCuadra"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Número de Cuadra"
                app:boxStrokeColor="#1E3D1E"
                app:hintTextColor="#1E3D1E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCuadra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ─────────────────────────────────────── -->
            <!-- FOTO DEL EQUINO                         -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#C8860A"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FDFAF5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FOTO DEL EQUINO"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:textColor="#7D5A2E"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgFotoEquino"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeColor="#C8860A"
                        app:strokeWidth="2dp"
                        android:src="@drawable/ic_horse_placeholder"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSeleccionarFotoEquino"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Galería"
                            app:strokeColor="#7D5A2E"
                            app:iconTint="#7D5A2E"
                            android:textColor="#7D5A2E"
                            app:icon="@android:drawable/ic_menu_gallery"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTomarFotoEquino"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cámara"
                            app:strokeColor="#7D5A2E"
                            app:iconTint="#7D5A2E"
                            android:textColor="#7D5A2E"
                            app:icon="@android:drawable/ic_menu_camera"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────── -->
            <!-- SEPARADOR — Asignaciones                -->
            <!-- ─────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="#8B1A2E"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Asignaciones"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="#1E3D1E"
                    android:textAllCaps="true"/>

                <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="1dp"
                    android:background="#C8860A"
                    android:alpha="0.4"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <!-- PROPIETARIO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:strokeColor="#1E3D1E"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#F0F5F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤  Propietario"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:textColor="#1E3D1E"
                        android:textAllCaps="true"
                        android:layout_marginBottom="12dp"/>

                    <CheckBox
                        android:id="@+id/cbTienePropietario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Tiene propietario registrado?"
                        android:textColor="#2C2C2C"
                        android:buttonTint="#1E3D1E"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layPropietario"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Seleccionar Propietario"
                        android:visibility="gone"
                        app:boxStrokeColor="#1E3D1E"
                        app:hintTextColor="#1E3D1E">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerPropietario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DISCIPLINAS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:strokeColor="#1E3D1E"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#F0F5F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐴  Disciplinas entrenadas"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:textColor="#1E3D1E"
                        android:textAllCaps="true"
                        android:layout_marginBottom="12dp"/>

                    <CheckBox
                        android:id="@+id/cbTieneEspecialidadesEquino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Tiene disciplinas entrenadas?"
                        android:textColor="#2C2C2C"
                        android:buttonTint="#1E3D1E"/>

                    <LinearLayout
                        android:id="@+id/layoutEspecialidadesEquino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:visibility="gone">

                        <CheckBox
                            android:id="@+id/cbDomaClasicaEquino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Doma Clásica"
                            android:textColor="#2C2C2C"
                            android:buttonTint="#1E3D1E"/>

                        <CheckBox
                            android:id="@+id/cbSaltoEquino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Salto"
                            android:textColor="#2C2C2C"
                            android:buttonTint="#1E3D1E"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN GUARDAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEquino"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="GUARDAR EQUINO"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1E3D1E"
                app:cornerRadius="8dp"/>
            <!-- PROGRESS -->
            <ProgressBar
                android:id="@+id/progressBarEquino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:indeterminateTint="#C8860A"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>