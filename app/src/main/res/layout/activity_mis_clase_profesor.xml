<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F5"> <!-- Fondo M3 Surface: Crema/Arena limpio -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMisClases"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5D3A1A"
        app:title="Mis Clases Asignadas"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#FFFFFF"/>

    <!-- INSTRUCCIÓN DE USO: Resaltada sutilmente en Dorado Cuero (#C8860A) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toca una clase para ver los alumnos inscritos"
        android:textColor="#C8860A"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp" />

    <!-- ESTADO VACÍO: Integrado cromáticamente con tonos tierra suaves -->
    <TextView
        android:id="@+id/tv_sin_clases"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No tienes clases asignadas"
        android:textColor="#8A7B6E"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:visibility="gone" />

    <!-- LISTA DE CLASES ASIGNADAS (RECYCLERVIEW) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mis_clases"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />

</LinearLayout>