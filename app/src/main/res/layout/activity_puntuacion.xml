<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F5">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPuntuacion"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5D3A1A"
        app:title="Puntuación"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#FFFFFF"/>
    <!-- INFO PARTICIPANTE (BINOMIO) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvJinete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Nombre del Jinete"
            android:textColor="#5D3A1A"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvCaballo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caballo"
            android:textColor="#8A7B6E"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- LISTA DE MOVIMIENTOS RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMovimientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />

    <!-- PANEL DE CORRECCIÓN Y GUARDADO  -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#EAD9C9"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Corrección"
                android:textColor="#8B1A2E"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <!-- FILA DE ERRORES  -->
            <RadioGroup
                android:id="@+id/rgCorreccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rb00"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="0.0\nLimpio"
                    android:checked="true"
                    android:textColor="#5D3A1A"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rb02"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="−2.0\n1º error"
                    android:textColor="#5D3A1A"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rb04"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="−4.0\n2º error"
                    android:textColor="#5D3A1A"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbElim"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="⛔ ELIM.\n3º error"
                    android:textSize="11sp"
                    android:textColor="#B71C1C" />
            </RadioGroup>

            <!-- RESUMEN CALCULADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvNotaFinal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Nota: —"
                    android:textColor="#5D3A1A"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvPorcentaje"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Porcentaje: —"
                    android:textColor="#8B1A2E"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end" />
            </LinearLayout>

            <!-- BOTÓN DE GUARDADO BURDEOS  -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="💾 Guardar puntuación"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="#8B1A2E"
                app:cornerRadius="100dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>