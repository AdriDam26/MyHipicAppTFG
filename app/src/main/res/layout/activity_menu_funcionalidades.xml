<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFE8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- TOOLBAR / HEADER                                                   -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#5D3A1A"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:gravity="center_horizontal">

            <!-- Logo + Nombre -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Círculo logo -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="26dp"
                        app:cardBackgroundColor="#C8860A"
                        app:strokeColor="#40FFFFFF"
                        app:strokeWidth="1.5dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_horse_logo"
                            android:contentDescription="@string/app_name" />

                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

                <!-- Textos nombre -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MY"
                        android:textSize="11sp"
                        android:textColor="#A6FFFFFF"
                        android:letterSpacing="0.2"
                        android:textStyle="normal" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hipic"
                            android:textSize="24sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="normal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App"
                            android:textSize="24sp"
                            android:textColor="#C8860A"
                            android:textStyle="normal" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LA REVOLUCIÓN ECUESTRE"
                        android:textSize="10sp"
                        android:textColor="#70FFFFFF"
                        android:letterSpacing="0.15" />
                </LinearLayout>
            </LinearLayout>

            <!-- Separador -->
            <View
                android:layout_width="200dp"
                android:layout_height="0.5dp"
                android:background="#26FFFFFF"
                android:layout_marginBottom="8dp" />

            <!-- Etiqueta menú -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MENÚ PRINCIPAL"
                android:textSize="10sp"
                android:textColor="#70FFFFFF"
                android:letterSpacing="0.2" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- TARJETAS DE MENÚ                                                   -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ─────────────────────────────────────── -->
            <!-- Gestión y Administración  #1E3D1E       -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGestionAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFAF5"
                app:rippleColor="#261E3D1E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Franja lateral acento -->
                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#1E3D1E" />

                    <!-- Icono -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_icon_round"
                        android:backgroundTint="#1A1E3D1E">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_manage"
                            app:tint="#1E3D1E"
                            android:contentDescription="Administración" />
                    </FrameLayout>

                    <!-- Textos -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gestión y Administración"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1E3D1E" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Panel de control general"
                            android:textSize="12sp"
                            android:textColor="#801E3D1E"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right"
                        android:alpha="0.3"
                        android:contentDescription="Abrir" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────── -->
            <!-- Escáner AR / QR  #7D5A2E               -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRealidadAumentada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFAF5"
                app:rippleColor="#267D5A2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#7D5A2E" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_icon_round"
                        android:backgroundTint="#1A7D5A2E">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#7D5A2E"
                            android:contentDescription="Escáner" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escáner AR / QR"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#7D5A2E" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escanea un código QR y ve la información de tu caballo en RA"
                            android:textSize="12sp"
                            android:textColor="#807D5A2E"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right"
                        android:alpha="0.3"
                        android:contentDescription="Abrir" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────── -->
            <!-- GPS / Rutas  #3A6B2E                   -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGPS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFAF5"
                app:rippleColor="#263A6B2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#3A6B2E" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_icon_round"
                        android:backgroundTint="#1A3A6B2E">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_dialog_map"
                            app:tint="#3A6B2E"
                            android:contentDescription="GPS" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GPS / Rutas"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#3A6B2E" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Graba y sigue tus rutas por el campo"
                            android:textSize="12sp"
                            android:textColor="#803A6B2E"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right"
                        android:alpha="0.3"
                        android:contentDescription="Abrir" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────── -->
            <!-- Reservar Clase  #C8860A                -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReservarClase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFAF5"
                app:rippleColor="#26C8860A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#C8860A" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_icon_round"
                        android:backgroundTint="#1AC8860A">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            app:tint="#C8860A"
                            android:contentDescription="Reservar Clase" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reservar Clase"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#C8860A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ve las proximas clases y haz tu reserva"
                            android:textSize="12sp"
                            android:textColor="#80C8860A"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right"
                        android:alpha="0.3"
                        android:contentDescription="Abrir" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────── -->
            <!-- Mis Reservas  #C8860A                  -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMisReservas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFAF5"
                app:rippleColor="#26C8860A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#C8860A" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_icon_round"
                        android:backgroundTint="#1AC8860A">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="#C8860A"
                            android:contentDescription="Mis Reservas" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mis Reservas"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#C8860A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ve tus clases reservadas"
                            android:textSize="12sp"
                            android:textColor="#80C8860A"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right"
                        android:alpha="0.3"
                        android:contentDescription="Abrir" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────── -->
            <!-- Ver Mis Clases (Profesor)  #5D3A1A     -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerClasesAsignadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFAF5"
                app:rippleColor="#265D3A1A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#5D3A1A" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_icon_round"
                        android:backgroundTint="#1A5D3A1A">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="#5D3A1A"
                            android:contentDescription="Mis Clases" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ver mis Clases"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#5D3A1A" />

                            <!-- Badge Profesor -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Profesor"
                                android:textSize="10sp"
                                android:textColor="#5D3A1A"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="#1A5D3A1A"
                                android:paddingStart="7dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ver mis Clases asignadas"
                            android:textSize="12sp"
                            android:textColor="#805D3A1A"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right"
                        android:alpha="0.3"
                        android:contentDescription="Abrir" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────── -->
            <!-- Mis Pruebas (Juez)  #8B1A2E            -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMisPruebas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFAF5"
                app:rippleColor="#268B1A2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#8B1A2E" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_icon_round"
                        android:backgroundTint="#1A8B1A2E">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#8B1A2E"
                            android:contentDescription="Mis Pruebas Asignadas" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mis Pruebas"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#8B1A2E" />

                            <!-- Badge Juez -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Juez"
                                android:textSize="10sp"
                                android:textColor="#8B1A2E"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="#1A8B1A2E"
                                android:paddingStart="7dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Califica a los participantes"
                            android:textSize="12sp"
                            android:textColor="#808B1A2E"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right"
                        android:alpha="0.3"
                        android:contentDescription="Abrir" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────── -->
            <!-- Ver Mis Competiciones  #8B1A2E         -->
            <!-- ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMisCompeticiones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FDFAF5"
                app:rippleColor="#268B1A2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#8B1A2E" />

                    <FrameLayout
