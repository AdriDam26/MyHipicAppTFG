<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2EAE0"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- BANDA LATERAL: Resaltada en Verde Pradera (#3A6B2E) -->
        <View
            android:id="@+id/view_banda"
            android:layout_width="6dp"
            android:layout_height="72dp"
            android:background="#3A6B2E"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre del recorrido en Verde Pradera -->
            <TextView
                android:id="@+id/tvNombreRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ruta del Encinar"
                android:textColor="#3A6B2E"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Fecha de realización en Cuero Oscuro -->
            <TextView
                android:id="@+id/tvFechaRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 May 2026"
                android:textColor="#5D3A1A"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />

            <!-- Métrica de Distancia con icono de localización/ruta -->
            <TextView
                android:id="@+id/tvDistanciaRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12.40 km"
                android:textColor="#6E7B6C"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:drawableStart="@android:drawable/ic_menu_directions"
                app:drawableTint="#6E7B6C" />

            <!-- Métrica de Duración con icono de reloj -->
            <TextView
                android:id="@+id/tvDuracionRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:45:20"
                android:textColor="#6E7B6C"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="4dp"
                android:drawablePadding="6dp"
                android:drawableStart="@android:drawable/ic_menu_recent_history"
                app:drawableTint="#6E7B6C" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>