<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FAF8FF"> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="🐴"
    android:textSize="64sp"
    android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EquiLab"
        android:textSize="36sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:textColor="#6750A4"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escanea el QR del caballo para ver su información en Realidad Aumentada"
        android:textSize="16sp"
        android:textColor="#49454F"
        android:alpha="0.8"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="48dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEscanear"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Escanear Código QR"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:letterSpacing="0.02"
        app:cornerRadius="28dp"
        app:icon="@android:drawable/ic_menu_camera"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="#6750A4"
        app:rippleColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Asegúrate de tener buena iluminación"
        android:textSize="12sp"
        android:textColor="#79747E" />

</LinearLayout>