<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapa ocupa toda la pantalla -->
    <fragment
        android:id="@+id/mapSeguir"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Card superior con info de la ruta (Material 3 Elevated Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfo"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#F4F9F3"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvNombreRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Siguiendo ruta"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:fontFamily="sans-serif-medium"
                android:textColor="#1A1C1E"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvDistanciaTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- km"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="#5D3A1A"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvAlPunto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esperando GPS..."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="#42474E"
                android:layout_marginBottom="12dp"/>

            <!-- Progreso con los colores de la ruta ecuestre -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="0"
                app:trackColor="#E1E5DC"
                app:indicatorColor="#3A6B2E"
                app:trackCornerRadius="4dp"/>

            <TextView
                android:id="@+id/tvProgreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="#3A6B2E"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="6dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Banner de ruta completada (Material 3 Tonal Style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bannerCompletado"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#3A6B2E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 ¡Ruta completada!"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Has recorrido todo el sendero hípico con éxito."
                android:textColor="#E8F5E9"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <!-- Botón Material 3 adaptado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalir"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terminar y salir"
                app:backgroundTint="#FFFFFF"
                android:textColor="#3A6B2E"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="20dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>