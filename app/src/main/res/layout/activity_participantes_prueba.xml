<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F5">

    <!-- TOOLBAR PERSONALIZADA: Identidad Cuero Oscuro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#5D3A1A"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVolverParticipantes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Volver"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvTituloPrueba"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Participantes"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!-- Subtítulo de la sección -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Orden de salida y lista de inscritos"
        android:textColor="#8B1A2E"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp" />

    <!-- Estado de lista vacía -->
    <TextView
        android:id="@+id/tvEmptyParticipantes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No hay participantes registrados en esta prueba."
        android:textColor="#8A7B6E"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- Lista de jinetes inscritos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvParticipantes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp" />

    <!-- BOTÓN PUBLICAR: Forzado el estilo para aceptar el tinte Burdeos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPublicarResultados"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="📢 Publicar resultados"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="#8B1A2E"
        app:cornerRadius="100dp"/>

</LinearLayout>