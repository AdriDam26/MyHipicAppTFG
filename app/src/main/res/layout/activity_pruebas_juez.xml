<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F5"> <!-- Fondo de la App: Arena claro -->

    <!-- TOOLBAR FIJA INAMOVIBLE: Cuero Oscuro (#5D3A1A) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#5D3A1A"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <!-- Botón Volver con área de toque M3 mejorada (48dp) y app:tint seguro -->
        <ImageButton
            android:id="@+id/btnVolverPruebas"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Volver"
            app:tint="@android:color/white" />

        <!-- Título unificado a sans-serif-medium sin negritas forzadas -->
        <TextView
            android:id="@+id/tv_titulo_pruebas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis Pruebas"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!-- TEXTO GUÍA DEL MÓDULO: Acento Burdeos de Competición (#8B1A2E) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona una prueba para gestionar los resultados"
        android:textColor="#8B1A2E"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp" />

    <!-- ESTADO VACÍO: Tono tierra secundario discreto (#8A7B6E) -->
    <TextView
        android:id="@+id/tvEmptyPruebas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No tienes pruebas asignadas en este momento."
        android:textColor="#8A7B6E"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- RECYCLERVIEW: Contenedor para las tarjetas de las pruebas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPruebas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp" />

</LinearLayout>