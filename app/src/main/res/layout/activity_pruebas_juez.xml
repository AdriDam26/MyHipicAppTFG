<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F5"> <!-- Fondo de la App: Arena claro -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPruebas"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5D3A1A"
        app:title="Mis Pruebas Asignadas"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#FFFFFF"/>

    <!-- TEXTO GUÍA DEL MÓDULO: Acento Burdeos de Competición (#8B1A2E) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona una prueba para gestionar los resultados"
        android:textColor="#8B1A2E"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp" />

    <!-- ESTADO VACÍO: Tono tierra secundario discreto (#8A7B6E) -->
    <TextView
        android:id="@+id/tvEmptyPruebas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No tienes pruebas asignadas en este momento."
        android:textColor="#8A7B6E"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- RECYCLERVIEW: Contenedor para las tarjetas de las pruebas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPruebas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp" />

</LinearLayout>