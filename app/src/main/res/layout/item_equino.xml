<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:flexbox="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EAF0EA"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/viewIndicatorEquino"
            android:layout_width="4dp"
            android:layout_height="72dp"
            android:background="#1E3D1E" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFotoEquino"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:src="@drawable/ic_horse_placeholder" />

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/txtNombreEquino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#1A1C1E"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Tornado del Valle Imperial" />

            <TextView
                android:id="@+id/txtRazaEquino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:textColor="#5D3A1A"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Pura Sangre Inglés de Competición Internacional" />

            <TextView
                android:id="@+id/txtMicrochipEquino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:textColor="#7A6855"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Chip: 981001234567890" />

            <!-- BADGES FLEXIBLES -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/layoutBadgesEquino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                flexbox:flexWrap="wrap"
                flexbox:alignItems="center">

                <TextView
                    android:id="@+id/txtDisciplinaEquino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#1E3D1E"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="#1A1E3D1E"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="DOMA + SALTO" />

                <TextView
                    android:id="@+id/txtTemperamentoEquino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#5D3A1A"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="#1F5D3A1A"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="MUY ENÉRGICO Y MANEJABLE" />

            </com.google.android.flexbox.FlexboxLayout>

        </LinearLayout>

        <!-- ACCIONES -->
        <LinearLayout
            android:id="@+id/layoutActionsEquino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnEditarEquino"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#7A6855" />

            <ImageButton
                android:id="@+id/btnEliminarEquino"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#8B1A2E" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>