<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapa ocupa todo el fondo -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Card superior con estadísticas (Estilo Hípico Integrado) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEstadisticas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2EAE0"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- BANDA LATERAL: Resaltada en Verde Pradera (#3A6B2E) -->
            <View
                android:id="@+id/view_banda_est"
                android:layout_width="6dp"
                android:layout_height="64dp"
                android:background="#3A6B2E"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Estado del GPS / Grabación -->
                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listo para grabar"
                    android:textColor="#3A6B2E"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp"/>

                <!-- Contenedor Métricas de Salida -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Distancia Recorrida -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DISTANCIA"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#5D3A1A"
                            android:alpha="0.8"/>

                        <TextView
                            android:id="@+id/tvDistancia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 km"
                            android:textColor="#1A1C1E"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Tiempo de marcha -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TIEMPO"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#5D3A1A"
                            android:alpha="0.8"/>

                        <TextView
                            android:id="@+id/tvTiempo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#1A1C1E"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Panel de Control Inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center">

        <!-- Botón Iniciar/Detener: Color Verde Pradera para la marcha -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarDetener"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Iniciar"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#3A6B2E"
            android:textColor="#FFFFFF"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="#FFFFFF"
            app:cornerRadius="16dp"/>

        <!-- Botón Guardar: Estilo perfilado con la identidad Cuero Oscuro -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Guardar"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"
            android:textColor="#5D3A1A"
            app:strokeColor="#5D3A1A"
            app:strokeWidth="1.5dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="#5D3A1A"
            app:cornerRadius="16dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>