<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EEF2F7">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ICONO -->
        <ImageView
            android:id="@+id/imgPista"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#E0F2FE
"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_compass"
            app:tint="#1F2937"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- NOMBRE -->
        <TextView
            android:id="@+id/txtNombrePista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/imgPista"
            app:layout_constraintEnd_toStartOf="@id/layoutActionsPista"
            app:layout_constraintTop_toTopOf="@id/imgPista"
            tools:text="Pista Principal"/>

        <!-- DIMENSIONES -->
        <TextView
            android:id="@+id/txtDimensionesPista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/imgPista"
            app:layout_constraintEnd_toStartOf="@id/layoutActionsPista"
            app:layout_constraintTop_toBottomOf="@id/txtNombrePista"
            tools:text="20m x 60m"/>

        <!-- AREA (badge moderno) -->
        <TextView
            android:id="@+id/txtAreaPista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#166534"
            android:backgroundTint="#DCFCE7"
            app:layout_constraintStart_toEndOf="@id/imgPista"
            app:layout_constraintTop_toBottomOf="@id/txtDimensionesPista"
            tools:text="1200 m²"/>

        <!-- ACCIONES -->
        <LinearLayout
            android:id="@+id/layoutActionsPista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnEditarPista"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#64748B"/>

            <ImageButton
                android:id="@+id/btnEliminarPista"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#EF4444"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>