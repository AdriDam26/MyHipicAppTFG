<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#7012121E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- BANDA SUPERIOR: FOTO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="110dp">

            <ImageView
                android:id="@+id/ivFotoEquino"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_horse_placeholder"
                android:background="#0D1117"/>

            <!-- Degradado inferior -->
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradiente_foto_abajo"/>

            <!-- Badge salud -->
            <TextView
                android:id="@+id/tvSalud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="BUENO"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#81C784"/>

        </FrameLayout>

        <!-- LÍNEA DE ACENTO -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/gradiente_acento"/>

        <!-- CUERPO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nombre -->
            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRUENO"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Raza -->
            <!-- Raza -->
            <TextView
                android:id="@+id/tvRaza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Raza del caballo"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginBottom="4dp"/>

            <!-- Propietario -->
            <TextView
                android:id="@+id/tvPropietario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Propietario: --"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginBottom="14dp"/>

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#12FFFFFF"
                android:layout_marginBottom="14dp"/>

            <!-- Fila stats: EDAD / PESO / ALTURA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EDAD" android:textColor="#4DFFFFFF" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tvEdad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- años" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PESO" android:textColor="#4DFFFFFF" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tvPeso" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- kg" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALTURA" android:textColor="#4DFFFFFF" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tvAltura" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- m" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Fila stats: SEXO / TEMPERAMENTO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEXO" android:textColor="#4DFFFFFF" android:textSize="8sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvSexo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMPERAMENTO" android:textColor="#4DFFFFFF" android:textSize="8sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvTemperamento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Chips -->
            <!-- Chips -->
            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSalto"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏇 SALTO"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    app:chipBackgroundColor="#CC0D47A1"
                    app:chipStrokeColor="#FF29B6F6"
                    app:chipStrokeWidth="1.5dp"
                    app:chipMinHeight="30dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDoma"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏇 DOMA"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    app:chipBackgroundColor="#CC6A0080"
                    app:chipStrokeColor="#FFCE93D8"
                    app:chipStrokeWidth="1.5dp"
                    app:chipMinHeight="30dp"/>

            </com.google.android.material.chip.ChipGroup>

            <!-- Microchip -->
            <TextView
                android:id="@+id/tvMicrochip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="SN: 000000000"
                android:textColor="#33FFFFFF"
                android:textSize="9sp"
                android:fontFamily="monospace"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>