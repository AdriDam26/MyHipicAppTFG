<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F5">

    <!-- TOOLBAR PRINCIPAL: Identidad Cuero Oscuro -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5D3A1A"
        app:titleTextColor="@android:color/white" />

    <!-- ESTADO VACÍO: Estilizado en tono Tierra sutil -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No tienes pruebas con resultados publicados."
        android:gravity="center"
        android:textColor="#8A7B6E"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- LISTA DE PRUEBAS CON RESULTADOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMisPruebas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false" />

</LinearLayout>