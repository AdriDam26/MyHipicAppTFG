<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EAF0EA"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp">

        <!-- BADGE ORDEN -->
        <FrameLayout
            android:id="@+id/imgBadgeOrden"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#1E3D1E"
            android:elevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- CÍRCULO INTERNO -->
            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#2D5A2D"/>

            <!-- NÚMERO -->
            <TextView
                android:id="@+id/txtOrdenSalida"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                tools:text="3"/>

        </FrameLayout>

        <!-- ACCIONES -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnEditarParticipacion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#7A6855"/>

            <ImageButton
                android:id="@+id/btnEliminarParticipacion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#8B1A2E"/>

        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/imgBadgeOrden"
            app:layout_constraintEnd_toStartOf="@id/layoutActions"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txtNombreJinete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1A1C1E"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Laura Gómez Fernández"/>

            <TextView
                android:id="@+id/txtNombreBinomio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#5D3A1A"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="🐴 Spirit de los Bosques"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>